# Copy this file to .env and fill in real values before running in production.

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production

# Set both to 1 once the site is live on https behind cPanel/nginx.
# SECURE_COOKIES keeps the session cookie off plain http connections;
# without https it silently breaks every login, so it stays 0 locally.
# BEHIND_PROXY makes login rate limiting see the visitor's real address
# rather than the proxy's - otherwise one guesser locks out everybody.
SECURE_COOKIES=0
BEHIND_PROXY=0

# Database (defaults to a local SQLite file if not set)
DATABASE_URL=sqlite:///brainwave.db

# Default admin account created by `flask seed-db` (only used the first time it runs)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-password

# WhatsApp sending (optional). Leave blank to use manual tap-to-send WhatsApp links instead.
# Requires a Twilio account with WhatsApp enabled: https://www.twilio.com/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Default country code used to normalize parent WhatsApp numbers entered without one
DEFAULT_COUNTRY_CODE=91
